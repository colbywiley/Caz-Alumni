# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated list of emails that are auto-promoted to admin on first sign-in
ADMIN_EMAILS=admin@example.org

# Resend (used to send branded "Invite Others" emails from the directory page).
# You can reuse the same API key configured for Supabase SMTP.
RESEND_API_KEY=re_YOUR-RESEND-KEY
# Must be a verified sender on a domain you've configured in Resend.
INVITE_FROM_EMAIL="Caz Alumni Connect <invites@yourdomain.org>"
